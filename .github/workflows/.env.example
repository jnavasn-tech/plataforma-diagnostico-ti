# Copiar este archivo como .env y completar con los valores reales.
# El archivo .env NUNCA debe subirse a un repositorio público.

DB_HOST=localhost
DB_NAME=plataforma_capacitacion
DB_USER=root
DB_PASS=

# API de Inteligencia Artificial usada por el módulo de diagnóstico
# y generación de rutas de aprendizaje (OpenAI y/o DeepSeek).
IA_PROVIDER=openai
IA_API_KEY=
IA_MODEL=gpt-4o-mini
